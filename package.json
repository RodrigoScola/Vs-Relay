{
  "name": "vs-relay",
  "private": false,
  "version": "0.1.0",
  "publisher": "rodrigoscola",
  "author": {
    "name": "Rodrigo Scola",
    "url": "https://github.com/RodrigoScola"
  },
  "sponsor": {
    "url": "https://ko-fi.com/rodrigoscola"
  },
  "displayName": "VS Relay",
  "keywords": [
    "mcp",
    "model context protocol",
    "claude",
    "claude code",
    "ai agent",
    "llm",
    "automation",
    "copilot"
  ],
  "bugs": {
    "url": "https://github.com/RodrigoScola/Vs-Relay/issues"
  },
  "homepage": "https://github.com/RodrigoScola/Vs-Relay",
  "description": "Make claude control your editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/RodrigoScola/Vs-Relay"
  },
  "workspaces": [
    "shared",
    "extension",
    "mcp-server"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "scripts": {
    "build": "npm run build --workspace=shared && npm run build --workspace=extension && npm run build --workspace=mcp-server",
    "watch": "npm run build --workspace=shared && concurrently \"npm:watch --workspace=extension\" \"npm:watch --workspace=mcp-server\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:extension": "npm run package --workspace=extension",
    "publish:extension": "npm run publish --workspace=extension",
    "update": "npm run package:extension && npm run publish:extension"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@vitest/ui": "^2.1.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
