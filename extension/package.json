{
  "name": "vs-relay",
  "version": "0.1.2",
  "publisher": "rodrigoscola",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "author": {
    "name": "Rodrigo Scola",
    "url": "https://github.com/RodrigoScola"
  },
  "sponsor": {
    "url": "https://ko-fi.com/rodrigoscola"
  },
  "displayName": "VS Relay",
  "bugs": {
    "url": "https://github.com/RodrigoScola/Vs-Relay/issues"
  },
  "homepage": "https://github.com/RodrigoScola/Vs-Relay",
  "description": "Make agents control your editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/RodrigoScola/Vs-Relay"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "agents",
    "agent clients",
    "copilot",
    "ai agent",
    "llm",
    "automation",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsRelay.restart",
        "title": "VS Relay: Restart Server"
      },
      {
        "command": "vsRelay.showStatus",
        "title": "VS Relay: Show Status"
      }
    ],
    "configuration": {
      "title": "VS Relay",
      "properties": {
        "vsRelay.port": {
          "type": "number",
          "default": 4823,
          "description": "Port the bridge WebSocket server listens on."
        },
        "vsRelay.mcpHttpPort": {
          "type": "number",
          "default": 4824,
          "description": "Port the bundled MCP server's HTTP endpoint listens on. The extension spawns this server on activation."
        },
        "vsRelay.autoConfigureMcp": {
          "type": "boolean",
          "default": true,
          "description": "On activation, automatically add a \"vs-relay\" MCP server entry to .mcp.json and .vscode/mcp.json in each open workspace folder if one isn't already present, pointing at this extension's bundled MCP server."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p . --noEmit && npm run bundle:extension && npm run bundle:mcp-server",
    "bundle:extension": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/extension.js --external:vscode",
    "bundle:mcp-server": "esbuild ../mcp-server/src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=bundled/mcp-server.cjs",
    "watch": "tsc -p . --watch",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies",
    "publish": "npm run build && npx @vscode/vsce publish --no-dependencies",
    "test": "vitest run"
  },
  "dependencies": {
    "@agents-vscode/shared": "0.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
